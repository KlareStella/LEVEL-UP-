{
  "name": "levelup-gamer-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node -e \"import('fs').then(f=>f.copyFileSync('dist/index.html','dist/404.html'))\"",
    "preview": "vite preview",
    "test": "karma start karma.conf.cjs",
    "test:jsdom": "NAVEGADOR=jsdom karma start karma.conf.cjs",
    "test:watch": "karma start karma.conf.cjs --no-single-run --auto-watch"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^8.0.0",
    "jasmine-core": "^7.0.2",
    "jsdom": "^30.1.3",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jsdom-launcher": "^22.0.0",
    "karma-spec-reporter": "^0.0.37",
    "karma-webpack": "^5.0.1",
    "vite": "^8.3.1",
    "webpack": "^5.112.1"
  }
}